# Copy locally to .env; never commit an actual key.
GEMINI_API_KEY=
# Repository .env is loaded without overriding existing process variables.
# If both key names exist MAFIS explicitly prefers GEMINI_API_KEY.
# The Developer API is selected explicitly, even if Vertex environment flags exist.
MAFIS_PRIMARY_MODEL=gemini-3.8-flash
MAFIS_DOCUMENT_MODEL=gemini-3.8-flash
MAFIS_FINANCIAL_MODEL=gemini-3.8-flash
MAFIS_CHROMA_PATH=chroma_db
MAFIS_TEMPERATURE=0
MAFIS_MAX_OUTPUT_TOKENS=4096
MAFIS_TRANSPORT_RETRIES=2
MAFIS_TIMEOUT_MS=30000
# A key alone never enables requests. The CLI also requires explicit --live.
